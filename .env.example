# Tudo roda local, sem chave de API nem custo por uso.

# Caminho do executável do Tesseract OCR (instalado em D:\ferramentas\Tesseract-OCR).
TESSERACT_CMD=D:\ferramentas\Tesseract-OCR\tesseract.exe

# Endereço do servidor Ollama local (rode "ollama serve" antes de usar o app).
OLLAMA_URL=http://127.0.0.1:11434

# Modelo local usado para gerar as explicações em português.
# Qwen3 4B Instruct quantizado: cerca de 2,5 GB, sem etapa de pensamento.
# Modelos são armazenados no D: pelo servidor Ollama iniciado pelo mascote.
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_MODELS_DIR=D:\ferramentas\Ollama-models

# Voz local (Piper TTS) que lê a explicação em voz alta.
# "Dii" é uma voz feminina pt-BR gratuita (CC BY-NC-ND, uso não comercial) da OpenVoiceOS:
# https://huggingface.co/OpenVoiceOS/pipertts_pt-BR_dii
PIPER_EXE=D:\ferramentas\Piper\piper\piper.exe
PIPER_VOICE=D:\ferramentas\Piper\voices\pt_BR-dii-medium.onnx

# Ajustes de entonação da voz: length_scale > 1 deixa a fala mais devagar e calma;
# noise_scale/noise_w controlam aleatoriedade; não controlam sentimentos.
PIPER_LENGTH_SCALE=0.98
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W=0.8

# Reconhecimento de voz local (faster-whisper) para o microfone do mascote. Multilíngue:
# entende português e inglês misturados na mesma frase (baixado automaticamente do
# Hugging Face na primeira vez que ligar o microfone, e guardado em WHISPER_DOWNLOAD_ROOT).
# "medium" é mais preciso mas mais lento em CPU (~1.7x a duração do áudio); "small" responde
# bem mais rápido (~0.65x) com precisão um pouco menor. Tenta usar a GPU automaticamente
# (precisa de driver NVIDIA com CUDA 12+); se não der, cai pra CPU sozinho.
WHISPER_MODEL_SIZE=small
WHISPER_DOWNLOAD_ROOT=D:\ferramentas\Whisper\models

# Silero distingue fala de ruído em blocos de 32 ms. O limiar de volume adaptativo
# reforça a detecção de interrupção durante a reprodução para reduzir eco.
MIC_LOUD_MULTIPLIER=1.6
MIC_MIN_LOUD_RMS=150
# O VAD usa histerese: entra com mais confiança e só sai depois de alguns
# frames baixos. O suavizador reduz disparos causados por estalos/teclas.
MIC_VAD_ONSET_PROBABILITY=0.60
MIC_VAD_RELEASE_PROBABILITY=0.35
MIC_VAD_ONSET_FRAMES=2
MIC_VAD_RELEASE_FRAMES=3
MIC_VAD_SMOOTHING_FRAMES=3

# A cada quantos segundos o mascote reanalisa a tela quando o compartilhamento está ligado.
SCREEN_INTERVAL_SECONDS=15

# Captura em blocos de 32 ms, com detector neural local de fala.
MIC_SILENCE_MS=480
MIC_MIN_SPEECH_MS=160
MIC_INTERRUPT_MS=608

# Caminho local das bibliotecas CUDA já fornecidas pelo Ollama.
WHISPER_CUDA_PATH=D:\ferramentas\Ollama\lib\ollama\cuda_v12
WHISPER_CPU_THREADS=4

# Estilo anime: tom mais agudo, com ritmo independente. Zero restaura a voz original.
VOICE_PITCH_SEMITONES=2.0
